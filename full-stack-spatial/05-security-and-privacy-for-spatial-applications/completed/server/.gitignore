# This lesson's server installs one npm package (ws): node_modules/ is
# rebuilt by `npm install` on any machine, so it is never committed. No
# lockfile is committed either -- a single pinned version in package.json
# is enough for this course.
node_modules/
package-lock.json

# The SQLite database and anything server.test.js writes.
data/

# The secret this lesson's completed/ version loads from the environment
# instead of hardcoding (see config.js, TODO 4). The starter's own
# config.js still hardcodes an obviously fake placeholder value for
# learning purposes; this line simply keeps the pattern consistent with
# completed/, in case you copy a real .env here while working through the
# TODOs.
.env
